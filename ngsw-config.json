{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.(svg|png|jpg|jpeg|webp|avif|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "google-books",
      "urls": [
        "https://www.googleapis.com/books/v1/volumes.*",
        "https://books.google.com/.*",
        "https://lh3.googleusercontent.com/.*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 30,
        "maxAge": "7d",
        "timeout": "5s"
      }
    },
    {
      "name": "open-library",
      "urls": [
        "https://openlibrary.org/api/books.*",
        "https://covers.openlibrary.org/.*"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 30,
        "maxAge": "30d",
        "timeout": "5s"
      }
    }
  ]
}
